{
  "$defs": {
    "AgentMetadata": {
      "properties": {
        "agent_id": {
          "default": "agent_02_prep",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_name": {
          "default": "Prep Manager",
          "title": "Agent Name",
          "type": "string"
        },
        "version": {
          "default": "2.0.0",
          "title": "Version",
          "type": "string"
        },
        "stage": {
          "default": 2,
          "title": "Stage",
          "type": "integer"
        }
      },
      "title": "AgentMetadata",
      "type": "object"
    },
    "CheckResult": {
      "properties": {
        "check_key": {
          "title": "Check Key",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/VerdictEnum"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "reason_code": {
          "default": "",
          "title": "Reason Code",
          "type": "string"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "required_by": {
          "items": {
            "type": "string"
          },
          "title": "Required By",
          "type": "array"
        },
        "observed_state": {
          "default": "",
          "title": "Observed State",
          "type": "string"
        },
        "measurements": {
          "additionalProperties": true,
          "title": "Measurements",
          "type": "object"
        },
        "regions": {
          "items": {
            "$ref": "#/$defs/Region"
          },
          "title": "Regions",
          "type": "array"
        },
        "remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation"
        },
        "model_version": {
          "default": "",
          "title": "Model Version",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        }
      },
      "required": [
        "check_key",
        "verdict",
        "confidence",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "DispatchSignal": {
      "enum": [
        "GREEN_RELEASE",
        "RED_REWORK",
        "AMBER_REVIEW"
      ],
      "title": "DispatchSignal",
      "type": "string"
    },
    "ImageDimensions": {
      "properties": {
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "ImageDimensions",
      "type": "object"
    },
    "ImageEvidence": {
      "properties": {
        "view": {
          "title": "View",
          "type": "string"
        },
        "file_path": {
          "description": "Storage reference (never served directly)",
          "title": "File Path",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Id"
        },
        "sha256_digest": {
          "title": "Sha256 Digest",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/ImageDimensions"
        },
        "quality": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImageQuality"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "view",
        "file_path",
        "sha256_digest",
        "dimensions"
      ],
      "title": "ImageEvidence",
      "type": "object"
    },
    "ImageQuality": {
      "properties": {
        "sharpness": {
          "description": "99.9th percentile |Laplacian| (edge strength); low = blur",
          "title": "Sharpness",
          "type": "number"
        },
        "glare_pct": {
          "description": "% of pixels clipped at sensor max",
          "title": "Glare Pct",
          "type": "number"
        },
        "exposure_mean": {
          "description": "Mean luminance 0-255",
          "title": "Exposure Mean",
          "type": "number"
        },
        "usable": {
          "title": "Usable",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "sharpness",
        "glare_pct",
        "exposure_mean",
        "usable"
      ],
      "title": "ImageQuality",
      "type": "object"
    },
    "OutcomeSummary": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/OverallDecisionEnum"
        },
        "decided_by": {
          "default": "agent_02_prep",
          "title": "Decided By",
          "type": "string"
        },
        "decided_at": {
          "title": "Decided At",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "dispatch": {
          "$ref": "#/$defs/DispatchSignal",
          "default": "AMBER_REVIEW"
        },
        "action_items": {
          "items": {
            "type": "string"
          },
          "title": "Action Items",
          "type": "array"
        }
      },
      "required": [
        "decision",
        "decided_at",
        "summary"
      ],
      "title": "OutcomeSummary",
      "type": "object"
    },
    "OverallDecisionEnum": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN",
        "PENDING_REVIEW"
      ],
      "title": "OverallDecisionEnum",
      "type": "string"
    },
    "OverrideEntry": {
      "properties": {
        "check_key": {
          "title": "Check Key",
          "type": "string"
        },
        "original_verdict": {
          "$ref": "#/$defs/VerdictEnum"
        },
        "new_verdict": {
          "$ref": "#/$defs/VerdictEnum"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "operator_id": {
          "title": "Operator Id",
          "type": "string"
        },
        "overridden_at": {
          "title": "Overridden At",
          "type": "string"
        },
        "previous_content_hash": {
          "default": "",
          "title": "Previous Content Hash",
          "type": "string"
        },
        "new_content_hash": {
          "default": "",
          "title": "New Content Hash",
          "type": "string"
        }
      },
      "required": [
        "check_key",
        "original_verdict",
        "new_verdict",
        "reason",
        "operator_id",
        "overridden_at"
      ],
      "title": "OverrideEntry",
      "type": "object"
    },
    "PerceptionInfo": {
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "model_calls": {
          "title": "Model Calls",
          "type": "integer"
        },
        "cost_usd": {
          "title": "Cost Usd",
          "type": "number"
        },
        "routing_reason": {
          "title": "Routing Reason",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model_version",
        "model_calls",
        "cost_usd",
        "routing_reason"
      ],
      "title": "PerceptionInfo",
      "type": "object"
    },
    "RecordStatusEnum": {
      "enum": [
        "completed",
        "overridden",
        "failed_open"
      ],
      "title": "RecordStatusEnum",
      "type": "string"
    },
    "Region": {
      "description": "Where on which image the evidence for a check was found. Normalised 0-1.",
      "properties": {
        "view_index": {
          "default": 0,
          "title": "View Index",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Bbox",
          "type": "array"
        }
      },
      "required": [
        "label",
        "bbox"
      ],
      "title": "Region",
      "type": "object"
    },
    "SubjectMetadata": {
      "properties": {
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "asin": {
          "title": "Asin",
          "type": "string"
        },
        "fnsku": {
          "title": "Fnsku",
          "type": "string"
        },
        "work_order_id": {
          "title": "Work Order Id",
          "type": "string"
        },
        "fba_shipment_id": {
          "title": "Fba Shipment Id",
          "type": "string"
        },
        "category": {
          "default": "general",
          "title": "Category",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "sku",
        "asin",
        "fnsku",
        "work_order_id",
        "fba_shipment_id"
      ],
      "title": "SubjectMetadata",
      "type": "object"
    },
    "TraceStep": {
      "properties": {
        "step": {
          "title": "Step",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "latency_ms": {
          "title": "Latency Ms",
          "type": "number"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "step",
        "status",
        "latency_ms"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "VerdictEnum": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN",
        "NOT_REQUIRED"
      ],
      "title": "VerdictEnum",
      "type": "string"
    }
  },
  "properties": {
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "schema_version": {
      "default": "2026.2",
      "title": "Schema Version",
      "type": "string"
    },
    "organization_id": {
      "title": "Organization Id",
      "type": "string"
    },
    "client_id": {
      "title": "Client Id",
      "type": "string"
    },
    "agent": {
      "$ref": "#/$defs/AgentMetadata"
    },
    "subject": {
      "$ref": "#/$defs/SubjectMetadata"
    },
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "operator_label": {
      "title": "Operator Label",
      "type": "string"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/ImageEvidence"
      },
      "title": "Images",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "outcome": {
      "$ref": "#/$defs/OutcomeSummary"
    },
    "overrides": {
      "items": {
        "$ref": "#/$defs/OverrideEntry"
      },
      "title": "Overrides",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RecordStatusEnum",
      "default": "completed"
    },
    "rules_version": {
      "default": "",
      "title": "Rules Version",
      "type": "string"
    },
    "requirements": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Requirements",
      "type": "array"
    },
    "attestations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Attestations",
      "type": "array"
    },
    "discrepancies": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Discrepancies",
      "type": "array"
    },
    "perception": {
      "anyOf": [
        {
          "$ref": "#/$defs/PerceptionInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Trace",
      "type": "array"
    },
    "total_latency_ms": {
      "default": 0.0,
      "title": "Total Latency Ms",
      "type": "number"
    },
    "content_hash": {
      "default": "",
      "title": "Content Hash",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "organization_id",
    "client_id",
    "subject",
    "captured_at",
    "operator_label",
    "images",
    "checks",
    "outcome"
  ],
  "title": "EvidenceRecord",
  "type": "object"
}