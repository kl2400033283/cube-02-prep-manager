{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CUBE Commerce Context Evidence Record",
  "description": "Standardized evidence record generated by Prep Manager (Agent 02) and consumed by Recovery Manager (Agent 05)",
  "type": "object",
  "required": [
    "record_id",
    "schema_version",
    "organization_id",
    "client_id",
    "agent",
    "subject",
    "captured_at",
    "operator_label",
    "images",
    "checks",
    "outcome",
    "overrides",
    "status",
    "content_hash"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^PRP-[0-9]{4,}$",
      "description": "Unique stage record identifier with PRP- prefix"
    },
    "schema_version": {
      "type": "string",
      "enum": ["2026.1", "2026.2"]
    },
    "organization_id": {
      "type": "string",
      "description": "Multi-tenant partition key (e.g. org_demo_alpha)"
    },
    "client_id": {
      "type": "string",
      "description": "Merchant or seller account identifier"
    },
    "agent": {
      "type": "object",
      "required": ["agent_id", "agent_name", "version", "stage"],
      "properties": {
        "agent_id": { "type": "string", "enum": ["agent_02_prep"] },
        "agent_name": { "type": "string", "enum": ["Prep Manager"] },
        "version": { "type": "string" },
        "stage": { "type": "integer", "enum": [2] }
      }
    },
    "subject": {
      "type": "object",
      "required": ["unit_id", "sku", "asin", "fnsku", "work_order_id", "fba_shipment_id"],
      "properties": {
        "unit_id": { "type": "string", "pattern": "^UNIT-[0-9]{4,}$" },
        "sku": { "type": "string" },
        "asin": { "type": "string" },
        "fnsku": { "type": "string" },
        "work_order_id": { "type": "string" },
        "fba_shipment_id": { "type": "string" }
      }
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "operator_label": {
      "type": "string",
      "description": "Badge ID of physical prep station operator"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["view", "file_path", "sha256_digest", "dimensions"],
        "properties": {
          "view": { "type": "string", "enum": ["front", "back", "label_detail", "seal_detail"] },
          "file_path": { "type": "string" },
          "sha256_digest": { "type": "string" },
          "dimensions": {
            "type": "object",
            "properties": {
              "width": { "type": "integer" },
              "height": { "type": "integer" }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_key", "verdict", "confidence", "detail", "model_version", "latency_ms"],
        "properties": {
          "check_key": {
            "type": "string",
            "enum": [
              "polybag_present_sealed",
              "suffocation_warning",
              "fnsku_label_placement",
              "original_barcode_covered",
              "expiry_date",
              "handling_marks"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": ["PASS", "FAIL", "UNCERTAIN", "NOT_REQUIRED"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "detail": {
            "type": "string"
          },
          "evidence_metadata": {
            "type": "object"
          },
          "model_version": {
            "type": "string"
          },
          "latency_ms": {
            "type": "integer"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["decision", "decided_by", "decided_at"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNCERTAIN", "PENDING_REVIEW"]
        },
        "decided_by": {
          "type": "string"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_key", "original_verdict", "new_verdict", "reason", "operator_id", "overridden_at"],
        "properties": {
          "check_key": { "type": "string" },
          "original_verdict": { "type": "string" },
          "new_verdict": { "type": "string" },
          "reason": { "type": "string" },
          "operator_id": { "type": "string" },
          "overridden_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["completed", "pending", "overridden", "failed_open"]
    },
    "content_hash": {
      "type": "string",
      "description": "Cryptographic SHA-256 digest calculated over normalized payload"
    }
  }
}
